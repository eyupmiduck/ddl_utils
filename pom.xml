<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.eyupmiduck</groupId>
    <artifactId>ddl-utils-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>docker_java_config</module>
        <module>ddl_utils</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <junit.version>6.1.3</junit.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <postgresql.version>42.7.13</postgresql.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <liquibase.version>5.0.4</liquibase.version>
        <jooq.version>3.21.8</jooq.version>
        <jakarta-xml-bind.version>4.0.2</jakarta-xml-bind.version>
        <testcontainers-jooq-codegen.version>0.0.4</testcontainers-jooq-codegen.version>
        <liquibase-validation.version>0.3.0</liquibase-validation.version>
    </properties>

    <!-- The PostgreSQL image used for jOOQ codegen and integration tests is a
         single source of truth: the `postgres.image` property. It is set by
         exactly one of the two profiles below (the default, or from the
         POSTGRES_IMAGE environment variable) and can always be overridden on
         the command line with -Dpostgres.image=postgres:16-alpine. -->
    <profiles>
        <profile>
            <id>postgres-image-from-env</id>
            <activation>
                <property>
                    <name>env.POSTGRES_IMAGE</name>
                </property>
            </activation>
            <properties>
                <postgres.image>${env.POSTGRES_IMAGE}</postgres.image>
            </properties>
        </profile>
        <profile>
            <id>default-postgres-image</id>
            <activation>
                <property>
                    <name>!env.POSTGRES_IMAGE</name>
                </property>
            </activation>
            <properties>
                <postgres.image>ddl-utils-postgres:17-alpine</postgres.image>
            </properties>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-core</artifactId>
                <version>${liquibase.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jooq</groupId>
                <artifactId>jooq</artifactId>
                <version>${jooq.version}</version>
            </dependency>
            <!-- jOOQ declares this as optional (opt-in), so it is not pulled
                 transitively. Compiling against jOOQ without it makes javac
                 emit -Xlint:classfile warnings for the unresolved JAXB
                 annotations. -->
            <dependency>
                <groupId>jakarta.xml.bind</groupId>
                <artifactId>jakarta.xml.bind-api</artifactId>
                <version>${jakarta-xml-bind.version}</version>
            </dependency>
            <!-- Transitive via Testcontainers; override to a patched version. -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- liquibase-validation is published to GitHub Packages. Credentials for
         the `github` server id must be supplied in ~/.m2/settings.xml (a
         classic PAT with read:packages), or via actions/setup-java in CI. -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/eyupmiduck/liquibase_validation</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <!-- Fail the build on any javac lint warning. The
                             JAXB/JOOQ classfile warnings are resolved by the
                             provided jakarta.xml.bind-api dependency. -->
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.testcontainers</groupId>
                    <artifactId>testcontainers-jooq-codegen-maven-plugin</artifactId>
                    <version>${testcontainers-jooq-codegen.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-requirements</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
