<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.eyupmiduck</groupId>
        <artifactId>ddl-utils-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ddl_utils</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Puts docker-java.properties (Docker API pin) on the test classpath -->
        <dependency>
            <groupId>io.github.eyupmiduck</groupId>
            <artifactId>docker_java_config</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.eyupmiduck</groupId>
            <artifactId>changelog_validator</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- jOOQ codegen against a real PostgreSQL container built from the
                 custom image (roles baked in), migrated with Liquibase as the
                 ddl_utils_owner role (like a real deployment). Requires a
                 running Docker daemon and the custom image built first. -->
            <plugin>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-jooq-codegen-maven-plugin</artifactId>
                <dependencies>
                    <!-- Override the plugin's bundled Testcontainers 1.19.1: its
                         docker-java is too old for Docker 29 (needs API >= 1.40). -->
                    <dependency>
                        <groupId>org.testcontainers</groupId>
                        <artifactId>testcontainers</artifactId>
                        <version>${testcontainers.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.testcontainers</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${testcontainers.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                    <!-- Override the plugin's bundled jOOQ 3.18.3: it cannot read
                         PostgreSQL 17 catalogs (key_seq error during codegen). -->
                    <dependency>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq</artifactId>
                        <version>${jooq.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq-codegen</artifactId>
                        <version>${jooq.version}</version>
                    </dependency>
                    <!-- Puts docker-java.properties (Docker API pin) on the plugin
                         classpath -->
                    <dependency>
                        <groupId>io.github.eyupmiduck</groupId>
                        <artifactId>docker_java_config</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>generate-jooq-sources</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <database>
                                <type>POSTGRES</type>
                                <containerImage>${postgres.image}</containerImage>
                                <username>ddl_utils_owner</username>
                                <password>ddl_utils_owner</password>
                                <databaseName>ddl_utils</databaseName>
                            </database>
                            <liquibase>
                                <changeLogPath>src/main/resources/db/changelog/db.changelog-master.xml</changeLogPath>
                            </liquibase>
                            <jooq>
                                <generator>
                                    <database>
                                        <includes>.*</includes>
                                        <inputSchema>ddl_utils</inputSchema>
                                    </database>
                                    <target>
                                        <packageName>io.github.eyupmiduck.ddlutils.jooq</packageName>
                                        <directory>target/generated-sources/jooq</directory>
                                    </target>
                                </generator>
                            </jooq>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- SQLFluff lints the Liquibase .sql files. Requires sqlfluff on PATH
                 (e.g. the repo's .venv). Skip with -Dskip.sqlfluff. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>sqlfluff-lint</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>sqlfluff</executable>
                            <arguments>
                                <argument>lint</argument>
                                <argument>src/main/resources/db/changelog</argument>
                            </arguments>
                            <skip>${skip.sqlfluff}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Pass the PostgreSQL image to tests so they use the same
                 version as jOOQ codegen. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <postgres.image>${postgres.image}</postgres.image>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
