<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-schema" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/001-create-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/001-create-schema-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="002-create-lib-schema" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/002-create-lib-schema.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/002-create-lib-schema-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="003-create-lock-settings" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/003-create-lock-settings.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/003-create-lock-settings-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <changeSet id="004-create-domains" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/004-create-domains.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/004-create-domains-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- The composite the lock-aware wrappers read get_lock_settings into; it
         must exist before the routines that declare a variable of it, so it is
         created here rather than after the routine includes. -->
    <changeSet id="006-create-lock-settings-type" author="lee.horner" dbms="postgresql">
        <sqlFile path="sql_changes/006-create-lock-settings-type.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/006-create-lock-settings-type-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>

    <!-- Stored routines: one changeset each, one file per routine. -->
    <include file="functions.xml" relativeToChangelogFile="true"/>
    <include file="procedures.xml" relativeToChangelogFile="true"/>

    <!-- The tables' triggers, one per file. They call routines defined above,
         so they run after the functions include. New tables created by later
         changesets must attach the same trigger. -->
    <include file="triggers.xml" relativeToChangelogFile="true"/>

    <!-- A single, re-runnable changeset for all caller grants. runOnChange
         makes Liquibase re-apply it whenever this SQL changes, so new grants
         reach existing databases. Keep the statements idempotent. -->
    <changeSet id="999-grant-privileges" author="lee.horner" dbms="postgresql" runOnChange="true">
        <sqlFile path="sql_changes/999-grant-privileges.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="rollback/999-grant-privileges-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
