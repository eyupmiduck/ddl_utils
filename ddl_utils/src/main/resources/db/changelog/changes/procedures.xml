<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- One changeset per stored procedure, mirroring functions.xml. Each
         procedure lives in its own file under procedures/<schema>/ and is added
         with createProcedure (Liquibase has no createFunction/createProcedure
         distinction beyond the change type). runOnChange re-applies only the
         body that changed, and each routine carries its own rollback under
         procedures-rollback/<schema>/.

         A procedure commits between its ALTER TABLE steps, so it must run in
         autocommit; see procedures/README.md for the orchestration rules. -->
    <changeSet id="020-ensure_not_null" author="ddl_utils" dbms="postgresql" runOnChange="true">
        <createProcedure path="procedures/ddl_utils/ensure_not_null.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="procedures-rollback/ddl_utils/ensure_not_null-rollback.sql"
                     relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
