    <!-- One changeset per stored function. Each function lives in its own file
         under functions/<schema>/ and is added with createProcedure (Liquibase
         has no createFunction change type). runOnChange re-applies only the
         changeset whose body changed, and each one carries its own rollback.

         CREATE OR REPLACE only replaces a routine with an identical signature:
         changing RETURNS or the parameter names aborts the deploy, and changing
         a parameter type silently leaves the old overload behind. When a
         signature changes, add an explicit
         `DROP FUNCTION IF EXISTS <old signature>;` (for example another sqlFile
         in that routine's changeset) so the deprecated signature is removed.

         The order of the changesets is not significant (PL/pgSQL resolves called
         routines at first execution); most pairs list the lib helper before the
         ddl_utils wrapper, but that is not required. -->
    <changeSet id="function-ddl_utils.get_database_lock_settings" author="ddl_utils" dbms="postgresql"
