<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- One changeset loads every stored function. Each function lives in its
         own file under functions/<schema>/ and is added with createProcedure
         (Liquibase has no createFunction change type). runOnChange re-applies
         the whole changeset when a function body changes, replacing the
         routines. -->
    <changeSet id="005-create-functions" author="ddl_utils" runOnChange="true">
        <createProcedure path="functions/ddl_utils/get_database_lock_settings.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils/set_database_lock_settings.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils/get_schema_lock_settings.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils/set_schema_lock_settings.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils/clear_schema_lock_settings.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils/get_table_lock_settings.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils/set_table_lock_settings.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils/clear_table_lock_settings.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils/get_lock_settings.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils/add_columns.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils/add_column.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils_lib/alter_table.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils_lib/add_columns.sql" relativeToChangelogFile="true"/>
        <createProcedure path="functions/ddl_utils_lib/add_column.sql" relativeToChangelogFile="true"/>
        <rollback>
            <sqlFile path="functions-rollback/ddl_utils_lib/add_column-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils_lib/add_columns-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils_lib/alter_table-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils/add_column-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils/add_columns-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils/get_lock_settings-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils/clear_table_lock_settings-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils/set_table_lock_settings-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils/get_table_lock_settings-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils/clear_schema_lock_settings-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils/set_schema_lock_settings-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils/get_schema_lock_settings-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils/set_database_lock_settings-rollback.sql" relativeToChangelogFile="true"/>
            <sqlFile path="functions-rollback/ddl_utils/get_database_lock_settings-rollback.sql" relativeToChangelogFile="true"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
