root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown; do not strip them.
trim_trailing_whitespace = false

# Keep editors in step with SQLFluff's max_line_length (see .sqlfluff).
[*.sql]
max_line_length = 120
